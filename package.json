{
  "name": "editorial-tools",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4173 --strictPort",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src vite.config.ts",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" vite.config.ts",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" vite.config.ts",
    "test": "node scripts/validate.mjs",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "build:pages": "npm run build && node scripts/prepare-pages.mjs && node scripts/validate-pages.mjs",
    "check": "npm run typecheck && npm run lint && npm run test:unit && npm test && npm run build:pages"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.57.0",
    "@tailwindcss/vite": "4.3.5",
    "@testing-library/react": "16.3.3",
    "@types/node": "^22.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "eslint": "10.14.0",
    "jsdom": "31.0.0",
    "prettier": "3.6.2",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
}
